{
  "name": "ai-driven-development",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "dc:shell": "docker exec -it -u node -w /workspaces/ai-driven-development ai-driven-development-workspace-1 bash",
    "dc:claude": "docker exec -it -u node -w /workspaces/ai-driven-development ai-driven-development-workspace-1 claude",
    "task:new": "bash scripts/new-task.sh",
    "task:clean": "bash scripts/clean-task.sh",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.0"
  }
}
