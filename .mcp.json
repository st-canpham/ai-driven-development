{
  "mcpServers": {
    "mysql": {
      "command": "pnpm",
      "args": ["dlx", "@benborla29/mcp-server-mysql@2.0.9"],
      "env": {
        "MYSQL_HOST": "${MCP_MYSQL_HOST:-127.0.0.1}",
        "MYSQL_PORT": "${DB_PORT:-3306}",
        "MYSQL_USER": "booking_ro",
        "MYSQL_PASS": "booking_ro",
        "MYSQL_DB": "${DB_NAME:-booking}",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    },
    "context7": {
      "command": "pnpm",
      "args": ["dlx", "@upstash/context7-mcp@4.4.4"]
    }
  }
}
